#include <stdio.h>

int main() 
{
   int i,j,k,rows;
   printf("Enter number of rows:");
   scanf("%d",&rows);
   for(i=1;i<=rows;i++)
   {
       for(j=rows;j>i;j--)
       {
       printf(" "); //prints spaces
       }
       k=2;
       for(j=1;j<=(2*i)-1;j++) //prints numbers
       {
           if(j>i)  //palindrome number
           {
             printf("%d",j-k); 
             k=k+2;
           }
           else
           printf("%d",j);
       }
       printf("\n"); //changes line
   }

    return 0;
}
